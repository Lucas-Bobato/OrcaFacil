# Porta HTTP da API
PORT=3333

# Caminho do arquivo SQLite (relativo a apps/api)
DATABASE_PATH=./data/orcafacil.db

# Segredo para assinar os tokens JWT (obrigatório em produção; use um valor longo e aleatório)
JWT_SECRET=troque-este-segredo

# Validade do token (formato do jsonwebtoken: 7d, 12h...)
JWT_EXPIRES_IN=7d

# Origens permitidas para CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173
