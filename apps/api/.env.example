# Porta HTTP da API
PORT=3333

# Caminho do arquivo SQLite (relativo a apps/api)
DATABASE_PATH=./data/orcafacil.db

# Segredo para assinar os tokens JWT. Em produção é obrigatório, com pelo menos 32 caracteres aleatórios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vazio fora de produção: a API gera um segredo temporário e as sessões terminam ao reiniciar.
JWT_SECRET=

# Quantos proxies confiáveis existem à frente da API (ex.: 1). Sem isso, atrás de um proxy,
# todos os clientes parecem ter o mesmo IP e dividem os limites de tentativas.
# TRUST_PROXY=1

# Validade do token (formato do jsonwebtoken: 7d, 12h...)
JWT_EXPIRES_IN=7d

# Origens permitidas para CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173
